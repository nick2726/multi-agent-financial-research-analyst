# Optional but recommended for high-quality judge demo.
# Copy this file to .env and fill the values you have.

# Gemini / Google Generative AI used by Thesis Writer, News summarizer, and Filing summarizer.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# NewsAPI used by News Agent. Without this, public Google News RSS fallback is used.
NEWS_API_KEY=

# Local runtime settings.
LOG_LEVEL=INFO
LOG_FORMAT=text
PORT=8080
